# ============================================================
#  DONO AI — танзимоти муҳит (Environment Variables)
#  Ин файлро ба номи `.env` нусхабардорӣ кунед ва арзишҳоро пур намоед.
#  Файли `.env` ҳеҷ гоҳ ба Git фиристода намешавад (.gitignore).
# ============================================================

# --- Сервер ---
PORT=3000
NODE_ENV=development
# Доменаи озоди Railway (барои webhook-и Telegram лозим аст)
PUBLIC_URL=https://your-app.up.railway.app

# --- OpenAI ---
# Калид ТАНҲО дар backend кор мекунад ва ба frontend ҳеҷ гоҳ фиристода намешавад.
OPENAI_API_KEY=
# Модели Responses API (бояд vision-ро дастгир кунад, агар акс фиристед)
OPENAI_MODEL=gpt-4o-mini

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
# Пароли махсуси webhook (худамон мегузорем — барои санҷиши дақиқати дархост)
TELEGRAM_WEBHOOK_SECRET=
# Агар true бошад, ҳангоми `npm run bot` polling истифода мешавад (барои локалӣ)
TELEGRAM_POLLING=false

# --- Database ---
# Роҳи файли SQLite (агар node:sqlite дастрас бошад — Node >= 22.5)
DATABASE_URL=./data/dono.sqlite
# Агар true бошад, ҳатто агар node:sqlite дастрас бошад, файли JSON истифода мешавад
FORCE_JSON_DB=false

# --- Амният ---
# Рӯйхати доменҳо бо вергул (CORS). Холӣ = ҳама
CORS_ORIGINS=
# Ҳадди дархостҳо барои ҳар IP
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# --- AI ---
# Агар true бошад ва OPENAI_API_KEY холӣ бошад, сервер дар «демо-режим» кор мекунад
AI_DEMO_MODE=true
